function InteractiveForm({ onSubmit }) {
  return (
    <form key='1' onSubmit={handleSubmit} className="form">
      <div key='1.1' className="form-group">
        <label key='1.1.1' htmlFor="name">Name:</label>
        <input
          key='1.1.2'
          id="name"
          type="text"
          onChange={handleNameChange}
          onBlur={validateName}
          onFocus={clearError} />
      </div>
      <div key='1.2' className="form-group">
        <label key='1.2.1' htmlFor="email">Email:</label>
        <input
          key='1.2.2'
          id="email"
          type="email"
          onChange={handleEmailChange}
          onBlur={validateEmail} />
      </div>
      <div key='1.3' className="actions">
        <button key='1.3.1' type="submit" onClick={handleClick}>
          Submit
        </button>
        <button key='1.3.2' type="button" onClick={handleCancel}>
          Cancel
        </button>
      </div>
    </form>
  );
}
