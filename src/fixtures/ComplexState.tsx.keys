function ShoppingCart({ items, total, discount, removeItem, checkout }) {
  const finalPrice = total - (total * discount / 100);

  return (
    <div key='1' className="cart">
      <h1 key='1.1'>Shopping Cart</h1>
      <div key='1.2' className="items">
        {items.map((item) => (
          <div key='1.2.1.1' key={item.id} className="cart-item">
            <img key='1.2.1.1.1' src={item.image} alt={item.name} />
            <div key='1.2.1.1.2' className="details">
              <h3 key='1.2.1.1.2.1'>{item.name}</h3>
              <p key='1.2.1.1.2.2'>Quantity: {item.quantity}</p>
              <p key='1.2.1.1.2.3'>${item.price}</p>
            </div>
            <button key='1.2.1.1.3' onClick={() => removeItem(item.id)}>Remove</button>
          </div>
        ))}
      </div>
      <div key='1.3' className="summary">
        <p key='1.3.1'>Subtotal: ${total}</p>
        {discount > 0 && <p key='1.3.2.1'>Discount: {discount}%</p>}
        <h2 key='1.3.3'>Total: ${finalPrice.toFixed(2)}</h2>
        <button key='1.3.4' onClick={checkout} disabled={items.length === 0}>
          Checkout
        </button>
      </div>
    </div>
  );
}
