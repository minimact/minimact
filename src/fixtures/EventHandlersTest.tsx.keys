/**
 * Test: Event handler transformation
 * Expected: onClick → private void HandleClick_N() methods
 *           Event handlers registered in props as strings
 */
import { useState } from '@minimact/core';

export function EventHandlersTest() {
  const [count, setCount] = useState(0);
  const [message, setMessage] = useState('');

  return (
    <div key='1'>
      <h1 key='1.1'>Count: {count}</h1>
      <button key='1.2' onClick={() => setCount(count + 1)}>
        Increment
      </button>
      <button key='1.3' onClick={() => setCount(count - 1)}>
        Decrement
      </button>
      <button key='1.4' onClick={() => setCount(0)}>
        Reset
      </button>
      <input
        key='1.5'
        value={message}
        onChange={(e) => setMessage(e.target.value)}
        placeholder="Type something..." />
    </div>
  );
}
