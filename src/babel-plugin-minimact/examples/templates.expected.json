{
  "componentName": "TemplatesExample",
  "templates": {
    "1.1.1": {
      "template": "Hello {0}!",
      "bindings": ["name"],
      "slots": [0]
    },
    "1.2.1": {
      "template": "You have {0} items in your cart",
      "bindings": ["count"],
      "slots": [0]
    },
    "1.3.1": {
      "template": "Total: ${0}",
      "bindings": ["price"],
      "slots": [0],
      "transforms": {
        "0": { "method": "toFixed", "args": [2] }
      }
    },
    "1.4.1": {
      "template": "Welcome back, {0}. Your balance is {1}.",
      "bindings": ["name", "__expr__:count,price"],
      "slots": [0, 1]
    }
  }
}
